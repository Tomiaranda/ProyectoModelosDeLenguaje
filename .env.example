# --- Modelo del agente (llm/adaptadores.py) ---
# Proveedores: openrouter | google_genai | lmstudio
MODEL_PROVIDER=openrouter
MODEL_NAME=google/gemma-4-31b-it:free
# Modelos de respaldo (OpenRouter los prueba si el principal da 429), separados por coma
MODEL_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b:free

# --- OpenRouter ---
# Clave desde https://openrouter.ai/keys (los modelos ":free" no tienen costo)
OPENROUTER_API_KEY=tu_api_key_aqui

# --- Google AI Studio ---
# OBLIGATORIA: se usa para los embeddings del RAG (gemini-embedding-001)
# Clave desde https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu_api_key_aqui

# --- LM Studio (solo si MODEL_PROVIDER=lmstudio) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Campus Virtual UTN FRM (MCP) ---
# Usuario y contraseña del campus. Quedan solo en tu .env, nunca se commitean.
CAMPUS_USER=tu_usuario
CAMPUS_PASS=tu_contraseña
# Ruta a campus_mcp.py (relativa a esta carpeta o absoluta)
CAMPUS_MCP_PATH=campus-utn-frm-mcp/campus_mcp.py
# Carpeta donde el MCP guarda los archivos que descarga
CAMPUS_DESCARGAS=descargas_campus

# --- Opcionales ---
# LLM_MAX_RETRIES=6     # reintentos con espera ante 429
# LLM_TIMEOUT=180
